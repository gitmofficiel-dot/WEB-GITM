rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdminOrPresident() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'president' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    function isTeacher() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function isRoleUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
    }
    
    function isNewUserDefaultRole() {
      return !('role' in request.resource.data) || request.resource.data.role == 'student' || request.resource.data.role == 'member';
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isNewUserDefaultRole();
      allow update: if (isOwner(userId) && isRoleUnchanged()) || isAdminOrPresident();
      allow delete: if isAdminOrPresident();
    }

    // GITM Root Collections
    match /news/{docId} {
      allow read: if true;
      allow write: if isAdminOrPresident();
    }
    match /events/{docId} {
      allow read: if true;
      allow write: if isAdminOrPresident();
    }
    match /projects/{docId} {
      allow read: if true;
      allow write: if isAdminOrPresident();
    }
    match /gallery/{docId} {
      allow read: if true;
      allow write: if isAdminOrPresident();
    }
    match /courses/{docId} {
      allow read: if true;
      allow create: if isTeacher() || isAdminOrPresident();
      allow update, delete: if isAdminOrPresident() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }
    match /grades/{docId} {
      allow read: if isAdminOrPresident() || isTeacher() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create: if isTeacher() || isAdminOrPresident();
      allow update, delete: if isAdminOrPresident() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
